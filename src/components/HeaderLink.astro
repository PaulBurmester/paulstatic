---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = Astro.url.pathname.startsWith(`${basePath}/`)
	? Astro.url.pathname.slice(basePath.length)
	: Astro.url.pathname;
const subpath = pathname.match(/[^\/]+/g);
const normalizedPathname = pathname.replace(/\/$/, '') || '/';
const normalizedHref = href?.replace(/\/$/, '') || href;
const isActive =
	normalizedHref === normalizedPathname || normalizedHref === '/' + (subpath?.[0] || '');
const linkHref = href?.startsWith('/') && !href.startsWith('//') ? `${basePath}${href}` : href;
---

<a href={linkHref} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
